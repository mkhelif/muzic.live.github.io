{{/* --- Events --- */}}
{{- $venues := partial "venues/descendants.html" .Params.id -}}
{{- $byVenue := (partialCached "index/events.html" .).Get "venues" -}}
{{- $events := slice -}}
{{- range $venues -}}
    {{- range (index $byVenue . | default slice) -}}
        {{- if not (in $events .) -}}
            {{- $events = $events | append . -}}
        {{- end -}}
    {{- end -}}
{{- end -}}
{{- $events = sort $events "Date" -}}
{{- partial "calendar/events.ics" (dict "page" . "events" $events) -}}
